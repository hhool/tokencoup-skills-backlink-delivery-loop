{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokencoup/skills/backlink-delivery-loop/prospect-snapshot.schema.json",
  "title": "prospect-snapshot",
  "description": "Contract C. A versioned, read-only export produced by tokencoup-skills-backlink-prospector. The consumer validates the version and rejects unknown fields rather than silently ignoring them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["center_domain", "schema_version", "generated_at", "source", "prospects"],
  "properties": {
    "center_domain": {"type": "string", "description": "The center domain (domain A) whose pool was exported."},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "generated_at": {"type": "string", "description": "ISO-8601 timestamp of the export."},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "file", "content_hash"],
      "properties": {
        "repo": {"type": "string"},
        "file": {"type": "string", "description": "Upstream store file the export was derived from."},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "prospects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "url", "type_key", "priority", "http_status", "acquired", "is_competitor", "is_gap"],
        "properties": {
          "domain": {"type": "string"},
          "url": {"type": "string", "description": "Site entry point. NOT the page where a link will appear."},
          "type_key": {"type": "string"},
          "priority": {"type": "integer", "minimum": 0, "maximum": 100},
          "http_status": {"type": ["integer", "null"]},
          "acquired": {"type": "boolean"},
          "is_competitor": {"type": "boolean"},
          "is_gap": {"type": "boolean"},
          "note": {"type": "string"},
          "note_en": {"type": "string"},
          "first_seen": {"type": ["string", "null"]},
          "last_seen": {"type": ["string", "null"]}
        }
      }
    }
  }
}
