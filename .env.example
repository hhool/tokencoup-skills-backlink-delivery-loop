# Copy to .env and adjust. Placeholders only; never commit a real .env.

BDL_HOME=.
BDL_SNAPSHOT_DIR=./data/snapshots
BDL_PROSE_DIR=./assets/prose
BDL_OUT_DIR=./data/out
BDL_HISTORY_DIR=./data/history
BDL_TEMPLATES_DIR=./data/templates
BDL_OBSERVATION_DIR=./data/observations
BDL_RECORDS_DIR=./data/records
BDL_FORMS_DIR=./data/forms
BDL_CENTER_DOMAIN=soundbuttons.cc
BDL_OWN_SITE_BASE=https://soundbuttons.cc
BDL_TIER=B
BDL_AUTO_TRANSMIT=false
BDL_AUTO_CONFIRM=false
BDL_DEFERRAL_WINDOW_DAYS=90
BDL_DAILY_CEILING=100
BDL_RECEIPT_WINDOW_DAYS=30
BDL_CONTACT_LOST_DAYS=180
# Transport receipts: read-only poll of the sending provider. Unset = manual.
BDL_PROVIDER=
BDL_PROVIDER_BASE_URL=
BDL_PROVIDER_API_KEY=
# The page the whole pool should link to (defaults to BDL_OWN_SITE_BASE).
# Without it every row stalls on a value that is identical across the pool.
BDL_OWN_LANDING_URL=
# Drafting: the address a recipient would reply to.
BDL_FROM_EMAIL=
BDL_FROM_NAME=
BDL_LOG_LEVEL=INFO
